+/* Fixed research assets only. The terminal keeps its own stock and workspace state. */
+(()=>{'use strict';
+ const link=document.getElementById('factorResearchOpen'),ticker=document.getElementById('activeSymbol');if(!link)return;
+ const sync=()=>{const raw=String(ticker?.textContent||'').trim();const symbol=/^[A-Z0-9][A-Z0-9.-]{0,39}$/.test(raw)?raw:'UNKNOWN';
+  const url=new URL('./factor-research.html',location.href);url.searchParams.set('symbol',symbol);link.href=url.href;link.dataset.factorContext=symbol;};
+ sync();if(ticker)new MutationObserver(sync).observe(ticker,{childList:true,characterData:true,subtree:true});
+ let dialog,frame,heading,close;
+ link.addEventListener('click',event=>{if(event.button!==0||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
+  if(typeof HTMLDialogElement==='undefined')return;
+  event.preventDefault();sync();
+  if(!dialog){dialog=document.createElement('dialog');dialog.className='factor-research-dialog';dialog.setAttribute('aria-label','因子研究资产');
+   const header=document.createElement('header');header.className='factor-research-dialog-head';heading=document.createElement('strong');
+   close=document.createElement('button');close.type='button';close.className='factor-research-entry';close.textContent='关闭研究资产';close.addEventListener('click',()=>dialog.close());
+   frame=document.createElement('iframe');frame.title='固定因子研究资产';frame.referrerPolicy='no-referrer';header.append(heading,close);dialog.append(header,frame);document.body.append(dialog);
+   dialog.addEventListener('close',()=>{frame.removeAttribute('src');link.focus();});}
+  heading.textContent='因子研究资产 · '+link.dataset.factorContext;
+  const url=new URL(link.href);url.searchParams.set('embedded','1');frame.src=url.href;
+  dialog.showModal();close.focus();
+ });
+})();
diff --git a/outputs/python_quant_bot/exchange_terminal/static/factor-research-model.js b/outputs/python_quant_bot/exchange_terminal/static/factor-research-model.js
new file mode 100644
index 0000000..aeca936
--- /dev/null
+++ b/outputs/python_quant_bot/exchange_terminal/static/factor-research-model.js
@@ -0,0 +1,24 @@
+export function canonical(value){if(value===null||typeof value!=='object')return JSON.stringify(value);if(Array.isArray(value))return '['+value.map(canonical).join(',')+']';return '{'+Object.keys(value).sort().map(key=>JSON.stringify(key)+':'+canonical(value[key])).join(',')+'}';}
+export function validateSnapshot(document){
+  const fail=message=>{throw new Error(message);};
+  if(!document||document.schema_version!=='hakimi.factor-research-binding@1')fail('研究快照版本不受支持');
+  if(!/^[a-f0-9]{64}$/.test(document.payload_sha256||''))fail('研究快照缺少指纹');
+  const p=document.payload;
+  if(!p||p.snapshot_id!=='library-U-20261114-binding-v1'||p.universe?.length!==1||p.universe[0]!=='QQQ')fail('研究身份或适用范围不符');
+  if(p.experiments?.['HK-F001']?.status!=='FAILED_ADMISSION'||p.experiments?.['HK-F002']?.status!=='DATA_HOLD')fail('固定研究状态被改变');
+  for(const id of ['HK-F001','HK-F002'])if(p.experiments[id].project_binding!=='NOT_CONFIRMED')fail('不能自动确认项目接入');
+  for(const key of ['decision_available','execution_authorized','training_requested','option_decision_available'])if(p.capabilities?.[key]!==false)fail('研究快照不能开启决策或执行');
+  if(!Array.isArray(p.factors)||p.factors.length!==10||new Set(p.factors.map(x=>x.factor_id)).size!==10)fail('因子身份集合不符');
+  const required=['momentum_5','momentum_20','trend_20_60','rsi_14','atr_14_pct','realized_vol_20','relative_volume_20','close_location','drawdown_60','regime.close_sma60_sign'];
+  for(const id of required){const f=p.factors.find(x=>x.factor_id===id);if(!f||typeof f.formula!=='string'||!f.formula||!/^[a-f0-9]{64}$/.test(f.source_sha256||'')||f.project_binding!=='NOT_CONFIRMED')fail('因子公式或来源不完整');}
+  if(p.new_economic_oos_events!==0||p.new_option_quote_paths!==0)fail('固定审计不能冒充新增经济样本');
+  return p;
+}
+export function normalizedSymbol(value){return typeof value==='string'&&/^[A-Z0-9][A-Z0-9.-]{0,39}$/.test(value)?value:'UNKNOWN';}
+export function deriveView(symbol,document){
+  const payload=validateSnapshot(document),selected=normalizedSymbol(symbol),covered=payload.universe.includes(selected);
+  return {symbol:selected,applicability:covered?'RESEARCH_UNIVERSE_ONLY':'NO_APPROVED_APPLICABILITY',
+    title:covered?'研究标的一致，接入仍未确认':'尚未建立适用映射',
+    message:covered?'QQQ 属于固定研究范围；同标的不代表通过验证，也不代表已接入当前内核。':`固定研究针对 QQQ；没有证据将九因子组合或过滤器用于 ${selected}。`,
+    decision_available:false,execution_authorized:false,signal_status:'UNAVAILABLE_RESEARCH_ONLY',payload};
+}
