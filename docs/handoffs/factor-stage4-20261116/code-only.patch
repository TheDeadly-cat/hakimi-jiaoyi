@@ -0,0 +1,24 @@
+import{canonical,validateSnapshot,deriveView}from'./factor-research-model.js';
+const $=id=>document.getElementById(id),node=(tag,text,cls)=>{const element=document.createElement(tag);if(text!==undefined)element.textContent=text;if(cls)element.className=cls;return element;};
+if(new URLSearchParams(location.search).get('embedded')==='1')document.body.dataset.embedded='true';
+async function load(){try{
+ const response=await fetch('./factor-research-binding.v1.json',{cache:'no-store'});if(!response.ok)throw new Error('快照读取失败');const snapshot=await response.json();
+ const payload=validateSnapshot(snapshot),bytes=new TextEncoder().encode(canonical(payload));
+ const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))).map(x=>x.toString(16).padStart(2,'0')).join('');
+ if(digest!==snapshot.payload_sha256)throw new Error('快照指纹不符');
+ $('researchSnapshotAge').textContent='固定历史资产，截至 '+payload.latest_available.newest_modified_at+'；不代表当前行情或后续研究更新。';
+ const view=deriveView(new URLSearchParams(location.search).get('symbol'),snapshot);
+ $('researchSymbol').textContent='当前标的：'+view.symbol;$('researchApplicability').textContent=view.title;$('researchContextMessage').textContent=view.message;
+ $('f001Status').textContent='组合未通过准入';$('f001Version').textContent=payload.experiments['HK-F001'].model_version+' · 接入未确认';
+ $('f002Status').textContent='DATA_HOLD';$('f002Version').textContent=payload.experiments['HK-F002'].preregistration_version+' · 接入未确认';
+ const rows=$('researchFactorRows');rows.replaceChildren();for(const factor of payload.factors){const row=node('div',undefined,'factor-research-row'),id=node('div'),formula=node('div');
+ id.append(node('strong',factor.title),node('code',factor.factor_id),node('p',factor.definition_version+' · 接入未确认'));
+ formula.append(node('p',factor.formula,'factor-research-formula'),node('p',factor.status==='PREREGISTERED_DATA_HOLD'?'已预登记；DATA_HOLD':'计算模块存在；未单独验证'));
+ row.append(id,formula);rows.append(row);}
+ const provenance=$('researchProvenance');provenance.append(node('p',`本次可访问 Library 目录共 ${payload.latest_available.total_listed} 项，最新固定审计 ${payload.latest_available.audit_id}。`));
+ provenance.append(node('p','只核对固定文件字节与原有记录；没有重新训练或重跑研究经济结果。'));
+ provenance.append(node('p',`项目范围扫描 ${payload.project_scan.scanned_files} 个源文件，未找到显式研究身份绑定；这不证明运行记录或整个项目都没有接入。`));
+ for(const source of payload.provenance){const item=node('div',undefined,'factor-research-provenance');item.append(node('p',source.name),node('p',source.sha256,'factor-research-hash'));provenance.append(item);}
+ document.body.dataset.researchLoaded='true';
+ }catch(error){$('researchApplicability').textContent='研究快照不可用';$('researchContextMessage').textContent='未生成任何当前因子或交易判断。';$('f001Status').textContent='未知';$('f002Status').textContent='未知';$('researchError').hidden=false;$('researchError').textContent='加载或核验失败：'+error.message;document.body.dataset.researchLoaded='error';}}
+load();
