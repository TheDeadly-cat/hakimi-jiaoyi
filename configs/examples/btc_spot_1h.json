{
  "name": "btc_spot_1h_research",
  "mode": "backtest",
  "market": "crypto_spot",
  "symbol": "BTC-USDT",
  "timeframe": "1h",
  "initial_cash": 10000,
  "data": {
    "provider": "csv",
    "history_limit": 500,
    "csv_path": "datasets/btc-usdt/1h/data.csv",
    "cache_dir": "",
    "use_cache": false
  },
  "strategy": {
    "name": "dual_ma",
    "params": {
      "fast_window": 20,
      "slow_window": 60,
      "position_pct": 0.25,
      "take_profit_pct": 0.08,
      "stop_loss_pct": 0.03
    }
  },
  "risk": {
    "max_position_pct": 0.35,
    "max_single_loss_pct": 0.03,
    "max_daily_loss_pct": 0.05,
    "max_leverage": 1,
    "min_cash_pct": 0.05
  },
  "execution": {
    "fee_rate": 0.0008,
    "slippage_pct": 0.0005
  },
  "logging": {
    "level": "INFO",
    "log_dir": "artifacts/logs"
  }
}
