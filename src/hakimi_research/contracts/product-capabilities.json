      },
      {
        "command": "replay",
        "capability": "research_replay"
      },
      {
        "command": "report-show",
        "capability": "research_report_read"
      },
      {
        "command": "backtest",
        "capability": "historical_backtest"
      },
      {
        "command": "capabilities",
        "capability": "product_capability_catalog"
      },
      {
        "command": "list-strategies",
        "capability": "strategy_catalog"
      },
      {
        "command": "optimize",
        "capability": "parameter_optimization"
      },
      {
        "command": "paper",
        "capability": "paper_execution"
      }
    ]
  }
